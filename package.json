{
  "name": "r34",
  "version": "0.4.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env EXPO_NO_DOTENV=1 expo start",
    "prebuild": "cross-env EXPO_NO_DOTENV=1 bun expo prebuild",
    "android": "cross-env EXPO_NO_DOTENV=1 expo run:android",
    "ios": "cross-env EXPO_NO_DOTENV=1 expo run:ios",
    "web": "cross-env EXPO_NO_DOTENV=1 expo start --web",
    "xcode": "xed -b ios",
    "doctor": "npx expo-doctor@latest",
    "start:staging": "cross-env APP_ENV=staging bun run start",
    "prebuild:staging": "cross-env APP_ENV=staging bun run prebuild",
    "prebuild:development": "cross-env APP_ENV=development bun run prebuild",
    "android:staging": "cross-env APP_ENV=staging bun run android",
    "ios:staging": "cross-env APP_ENV=staging bun run ios",
    "start:production": "cross-env APP_ENV=production bun run start",
    "prebuild:production": "cross-env APP_ENV=production bun run prebuild",
    "android:production": "cross-env APP_ENV=production bun run android",
    "ios:production": "cross-env APP_ENV=production bun run ios",
    "build:development:ios": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development --platform ios --local",
    "build:development:android": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development --platform android --local",
    "build:staging:ios": "cross-env APP_ENV=staging EXPO_NO_DOTENV=1 eas build --profile staging --platform ios --local",
    "build:staging:android": "cross-env APP_ENV=staging EXPO_NO_DOTENV=1 eas build --profile staging --platform android --local",
    "build:development:staging:android": "cross-env APP_ENV=staging EXPO_NO_DOTENV=1 eas build --profile development-staging --platform android --local",
    "build:production:ios": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 eas build --profile production --platform ios --local",
    "build:production:android": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 eas build --profile production --platform android --local",
    "app-release": "cross-env SKIP_BRANCH_PROTECTION=true np --no-publish --no-cleanup --no-release-draft",
    "version": "bun run prebuild && git add .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noemit",
    "test": "jest",
    "check-all": "bun run lint && bun run type-check && bun run test",
    "test:ci": "bun run test --coverage",
    "test:watch": "bun run test --watch",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^6.0.0",
    "@react-native-menu/menu": "^2.0.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.104.5",
    "app-icon-badge": "^0.1.2",
    "axios": "^1.20.0",
    "expo": "^58.0.17",
    "expo-application": "~58.1.2",
    "expo-brightness": "~58.0.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.25",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-video": "~58.0.12",
    "i18next": "^26.5.6",
    "moti": "^0.30.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.3",
    "react-native": "0.88.0",
    "react-native-capture-protection": "^2.4.2",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-query-kit": "^3.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^1.9.4",
    "@dev-plugins/react-query": "^0.4.0",
    "@expo/config": "^58.0.0",
    "@react-native-community/cli": "^20.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/i18n-js": "^4.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-expo": "~58.0.12",
    "jest-junit": "^17.0.0",
    "np": "^12.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.19",
    "ts-jest": "^29.4.15",
    "typescript": "~7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user/repo-name.git"
  },
  "packageManager": "bun@1.2.15",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": ["react-native-restart", "react-native-edge-to-edge"]
      }
    },
    "install": {
      "exclude": ["@expo/dom-webview", "typescript"]
    }
  },
  "osMetadata": {
    "initVersion": "7.0.5"
  }
}
